{
  "name": "mcre-tools",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "run-p api:build api:watch dev:vite",
    "dev:vite": "vite",
    "test": "vitest",
    "test:unit": "npm run test:once",
    "test:once": "vitest run",
    "e2e": "playwright test",
    "test:e2e": "npm run e2e",
    "test:e2e:debug": "playwright test --config=playwright.debug.config.ts",
    "build": "run-p type-check build-only",
    "build:dev": "VITE_DISTRIBUTION_DOMAIN_NAME=tools-dev.mcre.info VITE_API_DOMAIN_NAME=tools-api-dev.mcre.info VITE_OGP_DOMAIN_NAME=tools-ogp-dev.mcre.info VITE_SITE_NOINDEX=true npm run build",
    "build-only": "vite-ssg build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:dev": "npm run build:dev && npm run preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lambda:test": "python3 -m unittest discover backend/lambda/tests",
    "lambda:deploy:dev": "bash tools/deploy_lambda_dev.sh",
    "cdk:test": "cd backend/cdk && HOME=/tmp/mcre-tools-cdk-home PATH=.venv/bin:$PATH python3 -m unittest discover -s tests",
    "cdk": "cd backend/cdk && PATH=.venv/bin:$PATH cdk",
    "cdk:synth:dev": "CDK_ENV=dev npm run cdk -- synth --profile mcre-main",
    "cdk:diff:dev": "CDK_ENV=dev npm run cdk -- diff --all --profile mcre-main",
    "cdk:deploy:dev": "CDK_ENV=dev npm run cdk -- deploy --all --profile mcre-main",
    "cdk:synth:prod": "CDK_ENV=prod npm run cdk -- synth --profile mcre-main",
    "cdk:diff:prod": "CDK_ENV=prod npm run cdk -- diff --all --profile mcre-main",
    "cdk:deploy:prod": "CDK_ENV=prod npm run cdk -- deploy --all --profile mcre-main",
    "api:build": "rm -rf ./tmp-apis && npx openapi2aspida -c=./aspida.config.cjs -i=./openapi.yaml -o=./tmp-apis/ && rsync -a --delete ./tmp-apis/ ./src/apis/ && rm -rf ./tmp-apis",
    "api:watch": "chokidar ./openapi.yaml -c \"npm run api:build\"",
    "ants:icons": "node tools/generate_ant_icons.mjs",
    "ants:benchmark": "node tools/measure_ants.mjs",
    "ants:optimize": "node tools/optimize_ants.mjs"
  },
  "dependencies": {
    "@aspida/fetch": "^1.14.0",
    "@mdi/js": "^7.4.47",
    "@unhead/vue": "^2.1.17",
    "aspida": "^1.14.0",
    "dayjs": "^1.11.23",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.2"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^24.19.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "aws-cdk": "^2.1143.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "npm-run-all2": "^8.0.4",
    "openapi2aspida": "^0.24.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-ssg": "^28.3.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "picomatch": "^4.0.4"
  }
}
